# PostgreSQL connection string
DATABASE_URL=postgres://ckscope:ckscope@localhost:5432/ckscope

# CKB RPC endpoint. Leave unset to use public testnet defaults via CCC.
# CKB_RPC_URL=https://testnet.ckb.dev/rpc

# Number of blocks to backfill on first sync
SYNC_WINDOW=100

# Blocks fetched per batch
SYNC_BATCH_SIZE=50

# HTTP port for the Hono API
PORT=3000
